# Example environment variables for backend container.
# Copy this file to ".env" and fill the values. The orchestration layer will inject them on deploy.

# MCP configuration (optional; used by api.mcp.MCPClient)
MCP_SERVER_URL=https://your-mcp-server.example.com
MCP_API_KEY=replace-with-api-key

# Standard Django settings should be supplied by your environment (not hardcoded here)
# DJANGO_SECRET_KEY=...
# DJANGO_DEBUG=1
# ALLOWED_HOSTS=localhost,127.0.0.1
